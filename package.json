{
  "name": "prismhoof",
  "version": "1.0.0",
  "description": "PRISMHOOF - a rainbow-painting unicorn platformer. Entry for js13kGames 2026 (theme: Unicorns and Rainbows).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "build:debug": "node tools/build.mjs --debug",
    "build:verify": "node tools/build.mjs --verify",
    "build": "node tools/build.mjs --opt=2 --repeat=2",
    "check": "node tools/check-editor.mjs && node tools/check-levels.mjs",
    "zip": "node tools/zip.mjs",
    "release": "node tools/build.mjs --opt=2 --repeat=2 && node tools/zip.mjs"
  },
  "devDependencies": {
    "@gfx/zopfli": "^1.0.15",
    "clean-css": "^5.3.3",
    "esbuild": "^0.28.2",
    "google-closure-compiler": "^20260819.0.0",
    "roadroller": "^2.1.0",
    "terser": "^5.50.0"
  }
}
